generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trader {
  id                       String              @id @default(uuid())
  email                    String              @unique
  password                 String
  role                     Role                @default(TRADER)
  firstName                String?
  lastName                 String?
  status                   TraderStatus        @default(PENDING)
  passwordResetToken       String?
  passwordResetExpires     DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  emailVerificationExpires DateTime?
  emailVerificationToken   String?
  emailVerified            Boolean             @default(false)
  assignments              AccountAssignment[]
  coupons                  Coupon[]
  couponUsages             CouponUsage[]
  emailDeliveries          EmailDelivery[]
  evaluations              Evaluation[]
  fundedAccounts           FundedAccount[]
  ledgerEntries            LedgerEntry[]
  notifications            Notification[]
  orders                   Order[]
  auditLogs                AuditLog[]          @relation("AuditLogToTrader")

  @@index([role])
}

model Notification {
  id                String   @id @default(uuid())
  traderId          String
  type              String
  title             String
  message           String
  read              Boolean  @default(false)
  createdAt         DateTime @default(now())
  relatedEntityType String?
  relatedEntityId   String?
  trader            Trader   @relation(fields: [traderId], references: [id])

  @@index([traderId, read])
}

model Product {
  id           String      @id @default(uuid())
  name         String      @unique
  description  String?
  pricingPlan  String?
  settings     Json?
  isActive     Boolean     @default(true)
  accountSize  Decimal?    @db.Decimal(18, 2)
  price        Decimal?    @db.Decimal(18, 2)
  currency     String      @default("USD")
  rulesetId    String?
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderItems   OrderItem[]
  ruleset      Ruleset?    @relation(fields: [rulesetId], references: [id])
  auditLogs    AuditLog[]  @relation("AuditLogToProduct")
}

model Ruleset {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  products    Product[]
  versions    RulesetVersion[]
  auditLogs   AuditLog[]       @relation("AuditLogToRuleset")
}

model RulesetVersion {
  id             String               @id @default(uuid())
  version        String
  rulesetId      String
  status         RulesetVersionStatus @default(DRAFT)
  effectiveDate  DateTime?
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  evaluations    Evaluation[]
  fundedAccounts FundedAccount[]
  orders         Order[]
  rules          Rule[]
  ruleset        Ruleset              @relation(fields: [rulesetId], references: [id])

  @@unique([rulesetId, version])
}

model Rule {
  id               String           @id @default(uuid())
  rulesetVersionId String
  ruleType         RuleType
  name             String
  value            Json?
  isRequired       Boolean          @default(true)
  effectiveDate    DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  rulesetVersion   RulesetVersion   @relation(fields: [rulesetVersionId], references: [id])
  ruleEvaluations  RuleEvaluation[]
}

model MT5Account {
  id                      String              @id @default(uuid())
  accountNumber           String              @unique
  broker                  String?
  server                  String?
  login                   String?
  accountSize             Decimal?            @db.Decimal(18, 2)
  currency                String              @default("USD")
  purpose                 MT5AccountPurpose?
  status                  AccountStatus       @default(AVAILABLE)
  healthStatus            MT5HealthStatus     @default(DISCONNECTED)
  credentials             String?
  notes                   String?
  lastHealthCheck         DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  lastMonitoringAt        DateTime?
  currentMonitoringStatus String?
  currentMonitoringResult String?
  assignments             AccountAssignment[]
  evaluations             Evaluation[]
  fundedAccounts          FundedAccount[]
  jobs                    MonitoringJob[]
  ruleEvents              RuleEvent[]
  auditLogs               AuditLog[]          @relation("AuditLogToMT5Account")
}

model MonitoringJob {
  id           String     @id @default(uuid())
  jobId        String     @unique
  accountId    String
  workerId     String?
  status       JobStatus  @default(PENDING)
  attempt      Int        @default(1)
  timeoutMs    Int        @default(10000)
  retryable    Boolean    @default(false)
  errorCode    String?
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  leaseExpiry  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  account      MT5Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, status])
  @@index([status, leaseExpiry])
  @@index([workerId])
}

model Evaluation {
  id               String           @id @default(uuid())
  traderId         String
  rulesetVersionId String
  accountId        String?
  status           EvaluationStatus @default(IN_PROGRESS)
  startedAt        DateTime         @default(now())
  completedAt      DateTime?
  totalPnl         Decimal?         @db.Decimal(18, 2)
  maxDrawdown      Decimal?         @db.Decimal(18, 2)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  startingBalance  Decimal?         @db.Decimal(18, 2)
  account          MT5Account?      @relation(fields: [accountId], references: [id])
  rulesetVersion   RulesetVersion   @relation(fields: [rulesetVersionId], references: [id])
  trader           Trader           @relation(fields: [traderId], references: [id])
  fundedAccounts   FundedAccount[]
  ruleEvaluations  RuleEvaluation[]
  auditLogs        AuditLog[]       @relation("AuditLogToEvaluation")
}

model FundedAccount {
  id               String              @id @default(uuid())
  traderId         String
  accountId        String?
  rulesetVersionId String?
  status           FundedAccountStatus @default(PENDING)
  allocatedAt      DateTime?
  activatedAt      DateTime?
  closedAt         DateTime?
  totalPnl         Decimal?            @db.Decimal(18, 2)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  evaluationId     String?
  account          MT5Account?         @relation(fields: [accountId], references: [id])
  evaluation       Evaluation?         @relation(fields: [evaluationId], references: [id])
  rulesetVersion   RulesetVersion?     @relation(fields: [rulesetVersionId], references: [id])
  trader           Trader              @relation(fields: [traderId], references: [id])
  auditLogs        AuditLog[]          @relation("AuditLogToFundedAccount")
}

model AccountAssignment {
  id         String                  @id @default(uuid())
  traderId   String
  accountId  String
  status     AccountAssignmentStatus @default(ASSIGNED)
  assignedAt DateTime                @default(now())
  returnedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  account    MT5Account              @relation(fields: [accountId], references: [id])
  trader     Trader                  @relation(fields: [traderId], references: [id])

  @@unique([traderId, accountId, assignedAt])
}

model RuleEvaluation {
  id            String     @id @default(uuid())
  evaluationId  String
  ruleId        String
  result        RuleResult
  actualValue   Json?
  expectedValue Json?
  details       String?
  evaluatedAt   DateTime   @default(now())
  evaluation    Evaluation @relation(fields: [evaluationId], references: [id])
  rule          Rule       @relation(fields: [ruleId], references: [id])

  @@unique([evaluationId, ruleId])
}

model RuleEvent {
  id           String     @id @default(uuid())
  accountId    String
  eventType    String
  severity     String?
  message      String
  occurredAt   DateTime   @default(now())
  acknowledged Boolean    @default(false)
  account      MT5Account @relation(fields: [accountId], references: [id])
}

model Order {
  id               String          @id @default(uuid())
  orderNumber      String          @unique
  traderId         String
  rulesetVersionId String?
  status           OrderStatus     @default(CREATED)
  currency         String          @default("USD")
  subtotal         Decimal         @db.Decimal(18, 2)
  taxAmount        Decimal         @default(0) @db.Decimal(18, 2)
  totalAmount      Decimal         @db.Decimal(18, 2)
  idempotencyKey   String?         @unique
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  ledgerEntries    LedgerEntry[]
  rulesetVersion   RulesetVersion? @relation(fields: [rulesetVersionId], references: [id])
  trader           Trader          @relation(fields: [traderId], references: [id])
  orderItems       OrderItem[]

  @@index([traderId, status])
}

model OrderItem {
  id        String          @id @default(uuid())
  orderId   String
  productId String
  unitPrice Decimal         @db.Decimal(18, 2)
  currency  String          @default("USD")
  quantity  Int             @default(1)
  status    OrderItemStatus @default(PENDING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  order     Order           @relation(fields: [orderId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
}

model LedgerEntry {
  id          String            @id @default(uuid())
  entryNumber String            @unique
  traderId    String?
  orderId     String?
  referenceId String            @unique
  entryType   LedgerEntryType
  amount      Decimal           @db.Decimal(18, 2)
  direction   LedgerDirection
  currency    String            @default("USD")
  status      LedgerEntryStatus @default(PENDING)
  metadata    Json?
  createdBy   String?
  createdAt   DateTime          @default(now())
  order       Order?            @relation(fields: [orderId], references: [id])
  trader      Trader?           @relation(fields: [traderId], references: [id])

  @@index([traderId, entryType])
  @@index([orderId])
  @@index([referenceId])
}

model Coupon {
  id              String        @id @default(uuid())
  code            String        @unique
  discountPercent Int
  isActive        Boolean       @default(true)
  expiresAt       DateTime?
  totalUsageLimit Int?
  usedCount       Int           @default(0)
  createdById     String?
  createdAt       DateTime      @default(now())
  createdBy       Trader?       @relation(fields: [createdById], references: [id])
  usage           CouponUsage[]

  @@index([code])
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  traderId  String
  orderId   String?
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  trader    Trader   @relation(fields: [traderId], references: [id])

  @@unique([couponId, traderId, orderId])
}

model AuditLog {
  id             String          @id @default(uuid())
  action         AuditAction
  entityType     String
  entityId       String
  performedBy    String?
  details        Json?
  timestamp      DateTime        @default(now())
  evaluations    Evaluation[]    @relation("AuditLogToEvaluation")
  fundedAccounts FundedAccount[] @relation("AuditLogToFundedAccount")
  mt5Accounts    MT5Account[]    @relation("AuditLogToMT5Account")
  products       Product[]       @relation("AuditLogToProduct")
  rulesets       Ruleset[]       @relation("AuditLogToRuleset")
  traders        Trader[]        @relation("AuditLogToTrader")
}

model EmailDelivery {
  id                String              @id @default(uuid())
  traderId          String?
  recipient         String
  template          String
  subject           String?
  status            EmailDeliveryStatus @default(QUEUED)
  provider          EmailProviderType   @default(NONE)
  providerMessageId String?
  relatedEntityType String?
  relatedEntityId   String?
  idempotencyKey    String?             @unique
  attemptCount      Int                 @default(0)
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  failedAt          DateTime?
  failureReason     String?
  metadata          Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  trader            Trader?             @relation(fields: [traderId], references: [id])

  @@index([traderId])
  @@index([status])
  @@index([relatedEntityType, relatedEntityId])
  @@index([template])
  @@index([createdAt])
}

enum Role {
  TRADER
  ADMIN
}

enum TraderStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum EvaluationStatus {
  IN_PROGRESS
  PASSED
  FAILED
  ABANDONED
}

enum FundedAccountStatus {
  ACTIVE
  CLOSED
  SUSPENDED
  PENDING
  ELIGIBLE
  APPROVED
  TERMINATED
  COMPLETED
}

enum AccountStatus {
  AVAILABLE
  IN_USE
  INACTIVE
  MAINTENANCE
}

enum AccountAssignmentStatus {
  ASSIGNED
  RETURNED
  REVOKED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  TIMEOUT
  CANCELLED
}

enum MT5AccountPurpose {
  EVALUATION
  FUNDED
  OTHER
}

enum MT5HealthStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum RuleType {
  PROFIT_TARGET
  DRAWDOWN_LIMIT
  TRADING_HOURS
  MIN_TRADES
  MAX_DAILY_LOSS
  MAX_OPEN_TRADES
  MAX_LEVERAGE
  TRADING_SESSION
}

enum RulesetVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AuditAction {
  EVALUATION_STARTED
  EVALUATION_COMPLETED
  EVALUATION_FAILED
  RULE_CHANGED
  RULE_VERSION_CREATED
  RULE_CREATED
  RULE_UPDATED
  RULE_DELETED
  TRADER_CREATED
  TRADER_UPDATED
  TRADER_SUSPENDED
  ACCOUNT_CREATED
  ACCOUNT_UPDATED
  ACCOUNT_ASSIGNED
  ACCOUNT_RETURNED
  ACCOUNT_REVOKED
  FUNDED_ACCOUNT_CREATED
  FUNDED_ACCOUNT_CLOSED
  FUNDED_ACCOUNT_SUSPENDED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  RULESET_CREATED
  RULESET_UPDATED
  RULESET_VERSION_CREATED
  RULESET_VERSION_PUBLISHED
  CONFIGURATION_CHANGED
  SYSTEM_EVENT
  EVALUATION_LINK_PENDING
  EVALUATION_LINKED
  EVALUATION_LINK_FAILED
  ACCOUNT_RECOVERED
  RECOVERY_STARTED
  RECOVERY_SUCCEEDED
  RECOVERY_FAILED
  RECONCILIATION_STARTED
  RECONCILIATION_REPAIRED
  RECONCILIATION_SKIPPED
  RECONCILIATION_REJECTED
}

enum RuleResult {
  PASS
  FAIL
  WARNING
}

enum LedgerEntryStatus {
  PENDING
  POSTED
  REVERSED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerEntryType {
  CUSTOMER_PAYMENT
  REFUND
  PLATFORM_FEE
  TRADER_PAYOUT
  INTERNAL_ADJUSTMENT
}

enum OrderStatus {
  CREATED
  PENDING_PAYMENT
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

enum OrderItemStatus {
  PENDING
  FULFILLED
  ACTIVE
  CANCELLED
  FAILED
}

enum EmailDeliveryStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum EmailProviderType {
  GMAIL_SMTP
  CONSOLE
  NONE
}

enum EmailEventType {
  EMAIL_VERIFICATION_REQUESTED
  PASSWORD_RESET_REQUESTED
  PASSWORD_CHANGED
  WELCOME
  LOGIN_SECURITY_ALERT
  ORDER_CREATED
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  EVALUATION_STARTED
  EVALUATION_PASSED
  EVALUATION_FAILED
  ACCOUNT_ALLOCATED
  FUNDED_ACCOUNT_ACTIVATED
  ACCOUNT_STATUS_CHANGED
  RULE_BREACH_CONFIRMED
  PAYOUT_REQUESTED
  PAYOUT_APPROVED
  PAYOUT_REJECTED
}
