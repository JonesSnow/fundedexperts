# Copy to .env.test.local only after provisioning and independently verifying
# a disposable local PostgreSQL database. Empty confirmation fields are
# intentional: do not set them before verification.
TEST_DATABASE_URL=
TEST_DATABASE_DISPOSABLE=
# Set only after independent verification:
# I_HAVE_VERIFIED_THIS_IS_A_DISPOSABLE_TEST_DATABASE
TEST_DATABASE_DISPOSABLE_CONFIRMATION=
# Cleanup authorization is intentionally process-only and must not be stored
# in this file. See docs/test-environment.md.
